{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "api": {
      "root": ".",
      "framework": "fastapi"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "bindings": [
        {
          "type": "service",
          "service": "nlp",
          "format": "url",
          "env": "NLP_URL"
        }
      ]
    },
    "nlp": {
      "root": "nlp",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/agent/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
